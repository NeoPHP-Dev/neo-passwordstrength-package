{#
    Optional default UI for password strength — entirely opt-in.
    You can validate passwords with PasswordStrengthConfig::validate()
    without ever using this macro. See README for the three usage levels.

    Usage:
    {% import '@PasswordStrength/components/PasswordStrength.macro.html.twig' as PasswordStrength %}
    {{ PasswordStrength.render('password', passwordConfig) }}
#}
{% macro render(fieldName, config, instanceId = 'ps') %}
    <div class="ps-wrapper" id="{{ instanceId }}-root" data-config="{{ config.toJson() }}">
        <input type="password" name="{{ fieldName }}" class="ps-input" autocomplete="new-password">

        <div class="ps-bar-track">
            <div class="ps-bar-fill" data-role="bar"></div>
        </div>
        <span class="ps-score-label" data-role="score-label"></span>

        <ul class="ps-criteria" data-role="criteria"></ul>
    </div>
{% endmacro %}